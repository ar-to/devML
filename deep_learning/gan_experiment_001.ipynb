   "source": [
    "\n",
    "# quick test of the modulus operator\n",
    "imageGenStep = 20\n",
    "for e in range(1, 101):\n",
    "  if e == 1 or e % imageGenStep == 0:\n",
    "    print(f\"e is 1 or a multiple of {imageGenStep} ({e})\")"
